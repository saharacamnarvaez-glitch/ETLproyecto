    "ruta_gold = Path(\"../data/gold/gold_final.csv\")\n",
    "\n",
    "if ruta_gold.exists():\n",
    "    df_gold = pd.read_csv(ruta_gold)\n",
    "    \n",
    "    print(\"=== ANÁLISIS ESTADÍSTICO DE DESERCIÓN POR NIVEL DE RIESGO ===\")\n",
    "    # Excluimos \"Sin Datos\" para la estadística descriptiva pura\n",
    "    df_analisis = df_gold[df_gold['nivel_riesgo'] != 'Sin Datos']\n",
    "\n",
    "    resumen_estadistico = df_analisis.groupby('nivel_riesgo').agg(\n",
    "        Total_Programas=('programa', 'count'),\n",
    "        Promedio_Desercion=('tasa_desercion_2021', 'mean'),\n",
    "        Mediana_Desercion=('tasa_desercion_2021', 'median'),\n",
    "        Max_Desercion=('tasa_desercion_2021', 'max'),\n",
    "        Min_Desercion=('tasa_desercion_2021', 'min')\n",
    "    ).reset_index()\n",
    "\n",
    "    # de métricas a porcentaje\n",
    "    columnas_pct = ['Promedio_Desercion', 'Mediana_Desercion', 'Max_Desercion', 'Min_Desercion']\n",
    "    for col in columnas_pct:\n",
    "        resumen_estadistico[col] = resumen_estadistico[col].apply(lambda x: f\"{x*100:.1f}%\")\n",
    "\n",
    "    display(resumen_estadistico.sort_values(by='Promedio_Desercion', ascending=False))\n",
    "    \n",
    "    print(\"\\n=== MATRIZ DE PRIORIZACIÓN DEPARTAMENTAL (TOP 10 RIESGO ALTO) ===\")\n",
    "    matriz_riesgo = pd.crosstab(\n",
    "        index=df_gold['departamento'], \n",
    "        columns=df_gold['nivel_riesgo'], \n",
    "        margins=True, \n",
    "        margins_name=\"Total Programas\"\n",
    "    )\n",
    "    \n",
    "    if 'Riesgo Alto' in matriz_riesgo.columns:\n",
    "        matriz_riesgo = matriz_riesgo.sort_values(by='Riesgo Alto', ascending=False)\n",
    "        display(matriz_riesgo.head(11))"
   ]
  },
