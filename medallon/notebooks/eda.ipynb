    "    print(\"2. Muestra de los datos normalizados (sin tildes, en minúsculas, conservando espacios):\")\n",
    "    # Filtramos las columnas categóricas más importantes para la demostración\n",
    "    columnas_clave = ['departamento', 'municipio', 'institucion', 'programa']\n",
    "    columnas_mostrar = [col for col in columnas_clave if col in df_silver.columns]\n",
    "    \n",
    "    display(df_silver[columnas_mostrar].drop_duplicates().head(5))\n",
    "else:\n",
