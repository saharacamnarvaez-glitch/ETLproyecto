    "\n",
    "ruta_bronze_api = DATA_DIR / \"bronze\" / \"api\"\n",
    "\n",
    "if ruta_bronze_api.exists():\n",
    "    archivos_json = sorted(ruta_bronze_api.glob(\"*.json\"))\n",
    "    print(f\"Se encontraron {len(archivos_json)} archivo(s) JSON en la Capa Bronze de la API.\")\n",
    "\n",
    "    if archivos_json:\n",
    "        with open(archivos_json[0], \"r\", encoding=\"utf-8\") as f:\n",
    "            datos_json = json.load(f)\n",
    "\n",
    "        registros = datos_json if isinstance(datos_json, list) else datos_json.get(\"data\", [])\n",
    "        df_api_raw = pd.DataFrame(registros)\n",
    "        print(f\"Dimensiones del lote crudo de la API: {df_api_raw.shape[0]:,} filas y {df_api_raw.shape[1]} columnas.\")\n",
    "        display(df_api_raw.head(3))\n",
    "    else:\n",
    "        print(\"La carpeta de la API está vacía.\")\n",
    "else:\n",
    "    print(f\"No se encontró la ruta de la API en la Capa Bronze: {ruta_bronze_api}\")"
   ]
